e="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#777777;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="sign-in for everyone but readers" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#777777;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#777777;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#777777;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c37" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="Disclosure Hub: who does what" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=40;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="1300" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Draft to published in UK (RNS), US (EDGAR), DK (Nasdaq). Four roles, one rule: nobody approves their own work." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c6" value="Draft the announcement" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="335" y="241" width="240" height="86" as="geometry"/></mxCell><mxCell id="c7" value="Validate: UK, US or DK rules" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="615" y="241" width="240" height="86" as="geometry"/></mxCell><mxCell id="c9" value="Submit for review" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="241" width="240" height="86" as="geometry"/></mxCell><mxCell id="c11" value="Revise after changes requested" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1175" y="241" width="240" height="86" as="geometry"/></mxCell><mxCell id="c13" value="Author" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=3;strokeColor=#4A78B5;fillColor=#FFFFFF;fontSize=16;fontStyle=1;fontColor=#222222;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="222" width="54" height="96" as="geometry"/></mxCell><mxCell id="c14" value="role: author" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="160" height="44" as="geometry"/></mxCell><mxCell id="c17" value="Open the review inbox" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E9A4A;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="335" y="405" width="240" height="86" as="geometry"/></mxCell><mxCell id="c18" value="Compare revisions side by side" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E9A4A;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="615" y="405" width="240" height="86" as="geometry"/></mxCell><mxCell id="c20" value="Approve or request changes" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E9A4A;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="405" width="240" height="86" as="geometry"/></mxCell><mxCell id="c22" value="Four-eyes rule: the author cannot approve, and an approval counts only for the revision that was reviewed" style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#C9B800;strokeWidth=2;fontSize=14;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1165" y="397" width="260" height="98" as="geometry"/></mxCell><mxCell id="c23" value="Approver" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=3;strokeColor=#5E9A4A;fillColor=#FFFFFF;fontSize=16;fontStyle=1;fontColor=#222222;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="386" width="54" height="96" as="geometry"/></mxCell><mxCell id="c24" value="company secretary, legal or CFO" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="160" height="44" as="geometry"/></mxCell><mxCell id="c27" value="See what is ready" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98600;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="335" y="569" width="240" height="86" as="geometry"/></mxCell><mxCell id="c28" value="Publish to the newswire" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98600;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="615" y="569" width="240" height="86" as="geometry"/></mxCell><mxCell id="c30" value="Follow delivery, retry is automatic" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98600;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="569" width="240" height="86" as="geometry"/></mxCell><mxCell id="c32" value="Keep the receipt (RNS number, accession or announcement no.)" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98600;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1175" y="569" width="240" height="86" as="geometry"/></mxCell><mxCell id="c34" value="Publisher" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=3;strokeColor=#C98600;fillColor=#FFFFFF;fontSize=16;fontStyle=1;fontColor=#222222;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="550" width="54" height="96" as="geometry"/></mxCell><mxCell id="c35" value="role: publisher" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="160" height="44" as="geometry"/></mxCell><mxCell id="c38" value="Browse the public archive" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63A8;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="335" y="733" width="240" height="86" as="geometry"/></mxCell><mxCell id="c39" value="Filter by jurisdiction and text" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63A8;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="615" y="733" width="240" height="86" as="geometry"/></mxCell><mxCell id="c41" value="Follow by email, Atom or webhook" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63A8;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="733" width="240" height="86" as="geometry"/></mxCell><mxCell id="c43" value="Unsubscribe in one click" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63A8;strokeWidth=2;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1175" y="733" width="240" height="86" as="geometry"/></mxCell><mxCell id="c45" value="Reader or investor" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=3;strokeColor=#8A63A8;fillColor=#FFFFFF;fontSize=16;fontStyle=1;fontColor=#222222;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="714" width="54" height="96" as="geometry"/></mxCell><mxCell id="c46" value="no sign-in needed" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="160" height="44" as="geometry"/></mxCell><mxCell id="c48" value="AI pre-check agent&lt;br&gt;&lt;font style='font-size:13px'&gt;reads the draft, advisory only, never decides&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;strokeWidth=2;fontSize=15;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1640" y="221" width="285" height="100" as="geometry"/></mxCell><mxCell id="c50" value="Identity provider&lt;br&gt;&lt;font style='font-size:13px'&gt;Keycloak locally, Entra ID on Azure&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;strokeWidth=2;fontSize=15;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1640" y="40" width="285" height="100" as="geometry"/></mxCell><mxCell id="c52" value="Newswire&lt;br&gt;&lt;font style='font-size:13px'&gt;RNS (UK), EDGAR (US), Nasdaq Copenhagen (DK), mocked here. Files, and checks before every retry&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;strokeWidth=2;fontSize=15;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1640" y="549" width="285" height="100" as="geometry"/></mxCell><mxCell id="c54" value="Reader inbox or webhook&lt;br&gt;&lt;font style='font-size:13px'&gt;notified after publication, confirmed address, signed calls&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;strokeWidth=2;fontSize=15;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1640" y="713" width="285" height="100" as="geometry"/></mxCell><mxCell id="c56" value="Roles come from the identity provider (author, company_secretary, legal, cfo, publisher). There is no admin role." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="868" width="1650" height="30" as="geometry"/></mxCell><mxCell id="c57" value="Notifications and AI checks react to events after publication, so they can fail or lag without delaying a filing." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="898" width="1650" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
