<mxfile host="app.diagrams.net"><diagram id="d4" name="Local scaling"><mxGraphModel dx="1920" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1920" pageHeight="1010" math="0" shadow="0" defaultFontFamily="Helvetica"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c101" value="docker compose up --scale worker=3 (one machine)" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#2F6DB5;strokeWidth=2;fontSize=18;fontColor=#2F6DB5;fontStyle=1;align=left;verticalAlign=top;dashed=1;dashPattern=8 6;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1310" height="760" as="geometry"/></mxCell><mxCell id="c102" value="Show it in four steps" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=2;fontSize=20;fontColor=#444444;fontStyle=1;align=left;verticalAlign=top;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1390" y="150" width="490" height="760" as="geometry"/></mxCell><mxCell id="c103" value="Disclosure Hub on a laptop: how every container scales" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=40;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1500" height="56" as="geometry"/></mxCell><mxCell id="c104" value="One image, one ROLE variable per container. Each card says how that container scales, how far, and whether it was run or only designed." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1800" height="34" as="geometry"/></mxCell><mxCell id="c105" value='&lt;b&gt;web (nginx) :8080&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;serves the app, caches /api/public,&lt;br&gt;edge limit 100 req/s&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;0.25 vCPU · 128 MiB&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: Front Door Premium&lt;/font&gt;' style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;fontSize=15;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="205" width="250" height="140" as="geometry"/></mxCell><mxCell id="c106" value='&lt;b&gt;keycloak :8081&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;OIDC sign-in, roles in the token&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;1 vCPU · 1 GiB, dev mode&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: Microsoft Entra ID&lt;/font&gt;' style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;fontSize=15;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="250" height="140" as="geometry"/></mxCell><mxCell id="c107" value='&lt;b&gt;mailpit :8025&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;SMTP sink with an inbox page&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;0.25 vCPU · 128 MiB&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: Communication Services Email&lt;/font&gt;' style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;fontSize=15;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="525" width="250" height="140" as="geometry"/></mxCell><mxCell id="c108" value="SINGLE ON PURPOSE" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#555555;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="681" width="150" height="24" as="geometry"/></mxCell><mxCell id="c109" value="Stand-ins for managed services. They are not scaling targets: Azure replaces them." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#555555;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="70" y="712" width="250" height="70" as="geometry"/></mxCell><mxCell id="c110" value='&lt;b&gt;migrate&lt;/b&gt; &lt;font style="font-size:13px;color:#555555"&gt;(runs once)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;schema first, then api and worker start&lt;/font&gt;' style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F3F3;strokeColor=#666666;strokeWidth=2;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="250" height="90" as="geometry"/></mxCell><mxCell id="c111" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=1;dashPattern=6 5;opacity=70;" vertex="1" parent="1"><mxGeometry x="369" y="214" width="640" height="140" as="geometry"/></mxCell><mxCell id="c112" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="205" width="640" height="140" as="geometry"/></mxCell><mxCell id="c113" value='&lt;b&gt;api &amp;nbsp;ROLE=api :3000&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;REST, token check, public reads&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;0.5 vCPU · 512 MiB&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: 2 to 4 replicas&lt;/font&gt;' style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="374" y="217" width="250" height="120" as="geometry"/></mxCell><mxCell id="c114" value="" style="fontFamily=Helvetica;shape=line;strokeColor=#9CC3E8;strokeWidth=1;direction=south;" vertex="1" parent="1"><mxGeometry x="636" y="219" width="1" height="112" as="geometry"/></mxCell><mxCell id="c115" value="&lt;b&gt;Stateless:&lt;/b&gt; all state in PostgreSQL, the token is checked locally.&lt;br&gt;&lt;b&gt;Here:&lt;/b&gt; one container; host port 3000 is fixed, so drop that line to run N.&lt;br&gt;&lt;b&gt;Measured:&lt;/b&gt; about 80 write req/s per 0.5 vCPU." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="652" y="243" width="334" height="96" as="geometry"/></mxCell><mxCell id="c116" value="NOT RUN AS REPLICAS" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A6200;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9A6200;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="652" y="215" width="210" height="24" as="geometry"/></mxCell><mxCell id="c117" value="×1" style="fontFamily=Helvetica;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="924" y="191" width="62" height="30" as="geometry"/></mxCell><mxCell id="c118" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="378" y="390" width="640" height="140" as="geometry"/></mxCell><mxCell id="c119" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="369" y="381" width="640" height="140" as="geometry"/></mxCell><mxCell id="c120" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="372" width="640" height="140" as="geometry"/></mxCell><mxCell id="c121" value='&lt;b&gt;worker &amp;nbsp;ROLE=worker&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;files to the mock RNS, EDGAR or Copenhagen, retries&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;0.5 vCPU · 512 MiB each&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: 2 to 3 replicas&lt;/font&gt;' style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="374" y="384" width="250" height="120" as="geometry"/></mxCell><mxCell id="c122" value="" style="fontFamily=Helvetica;shape=line;strokeColor=#9CC3E8;strokeWidth=1;direction=south;" vertex="1" parent="1"><mxGeometry x="636" y="386" width="1" height="112" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;Safe:&lt;/b&gt; job lease with a token; idempotency key checked at the channel.&lt;br&gt;&lt;b&gt;Measured:&lt;/b&gt; 1 worker 9/s, 3 workers 27/s, no duplicates (200 ms newswire).&lt;br&gt;&lt;b&gt;Limit:&lt;/b&gt; 6 workers: every worker wakes on every NOTIFY." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="652" y="410" width="334" height="96" as="geometry"/></mxCell><mxCell id="c124" value="VERIFIED + MEASURED" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E7B34;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1E7B34;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="652" y="382" width="210" height="24" as="geometry"/></mxCell><mxCell id="c125" value="×3" style="fontFamily=Helvetica;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="924" y="358" width="62" height="30" as="geometry"/></mxCell><mxCell id="c126" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=1;dashPattern=6 5;opacity=70;" vertex="1" parent="1"><mxGeometry x="369" y="548" width="640" height="140" as="geometry"/></mxCell><mxCell id="c127" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="539" width="640" height="140" as="geometry"/></mxCell><mxCell id="c128" value='&lt;b&gt;notifier &amp;nbsp;ROLE=events&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;reader e-mails from the outbox&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;0.25 vCPU · 256 MiB&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: one app per consumer set&lt;/font&gt;' style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="374" y="551" width="250" height="120" as="geometry"/></mxCell><mxCell id="c129" value="" style="fontFamily=Helvetica;shape=line;strokeColor=#9CC3E8;strokeWidth=1;direction=south;" vertex="1" parent="1"><mxGeometry x="636" y="553" width="1" height="112" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b&gt;Safe:&lt;/b&gt; each delivery is claimed with a lease, so a second copy cannot double-send.&lt;br&gt;&lt;b&gt;Measured:&lt;/b&gt; outbox claim 110/s with 1 claimer, 180/s with 4; one notifier about 275 followers/s." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="652" y="577" width="334" height="96" as="geometry"/></mxCell><mxCell id="c131" value="MEASURED, NOT AS REPLICAS" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E3F0FF;strokeColor=#1F5FA8;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1F5FA8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="652" y="549" width="210" height="24" as="geometry"/></mxCell><mxCell id="c132" value="×1" style="fontFamily=Helvetica;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="924" y="525" width="62" height="30" as="geometry"/></mxCell><mxCell id="c133" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=1;dashPattern=6 5;opacity=70;" vertex="1" parent="1"><mxGeometry x="369" y="715" width="640" height="140" as="geometry"/></mxCell><mxCell id="c134" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="706" width="640" height="140" as="geometry"/></mxCell><mxCell id="c135" value='&lt;b&gt;agents &amp;nbsp;ROLE=events&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;AI pre-check, mock model, own consumer list&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;0.25 vCPU · 256 MiB&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: scaled on outbox lag&lt;/font&gt;' style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="374" y="718" width="250" height="120" as="geometry"/></mxCell><mxCell id="c136" value="" style="fontFamily=Helvetica;shape=line;strokeColor=#9CC3E8;strokeWidth=1;direction=south;" vertex="1" parent="1"><mxGeometry x="636" y="720" width="1" height="112" as="geometry"/></mxCell><mxCell id="c137" value="&lt;b&gt;Isolated:&lt;/b&gt; own process (REACTOR_CONSUMERS=agent:precheck), so a slow model never delays publishing or e-mails.&lt;br&gt;&lt;b&gt;Scale:&lt;/b&gt; like the notifier; each extra copy drains the same outbox." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="652" y="744" width="334" height="96" as="geometry"/></mxCell><mxCell id="c138" value="BY DESIGN, NOT RUN" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A6200;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9A6200;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="652" y="716" width="150" height="24" as="geometry"/></mxCell><mxCell id="c139" value="×1" style="fontFamily=Helvetica;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="924" y="692" width="62" height="30" as="geometry"/></mxCell><mxCell id="c140" value='&lt;b&gt;postgres 16&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#555555"&gt;data, job queue (LISTEN/NOTIFY),&lt;br&gt;event outbox, audit chain&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#222222"&gt;&lt;b&gt;The shared limit.&lt;/b&gt;&lt;br&gt;1 vCPU · 1 GiB, no standby here.&lt;br&gt;&lt;br&gt;Each process keeps a pool of 5 connections:&lt;br&gt;(api + workers + events) × 5&lt;br&gt;must stay under max_connections (100).&lt;br&gt;&lt;br&gt;This stack, 3 workers:&lt;br&gt;6 processes ≤ 30 connections.&lt;br&gt;Seen: 16 with 1 api + 2 workers.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:13px;color:#0078D4"&gt;Azure: Flexible Server,&lt;br&gt;zone-redundant HA, Entra-only&lt;/font&gt;' style="fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C98600;strokeWidth=2;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1070" y="205" width="250" height="620" as="geometry"/></mxCell><mxCell id="c141" value="SINGLE INSTANCE" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#555555;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="835" width="150" height="24" as="geometry"/></mxCell><mxCell id="c142" value="/api" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2F6DB5;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c105" target="c112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c143" value="reads, writes" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="c112" target="c140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c144" value="jobs" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c120" target="c140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c145" value="outbox" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="c127" target="c140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c146" value="outbox" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c134" target="c140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c147" value="SMTP" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c127" target="c107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c148" value="1" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1415" y="202" width="32" height="32" as="geometry"/></mxCell><mxCell id="c149" value="&lt;b&gt;Start with one worker&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1461" y="200" width="400" height="26" as="geometry"/></mxCell><mxCell id="c150" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F6FA;strokeColor=#C9D4E3;strokeWidth=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1461" y="232" width="400" height="92" as="geometry"/></mxCell><mxCell id="c151" value="RATE_LIMIT_PER_MIN=0 \&lt;br&gt;docker compose up --build -d \&lt;br&gt;&amp;nbsp;&amp;nbsp;--scale worker=1" style="fontFamily=Courier New;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1473" y="242" width="380" height="78" as="geometry"/></mxCell><mxCell id="c152" value="2" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1415" y="342" width="32" height="32" as="geometry"/></mxCell><mxCell id="c153" value="&lt;b&gt;Load it, note the rate&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1461" y="340" width="400" height="26" as="geometry"/></mxCell><mxCell id="c154" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F6FA;strokeColor=#C9D4E3;strokeWidth=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1461" y="372" width="400" height="92" as="geometry"/></mxCell><mxCell id="c155" value='GATEWAY_LATENCY_MS=200 \&lt;br&gt;AUTH=oidc npm run bench&lt;br&gt;&lt;font color="#555555"&gt;about 9 published/s&lt;/font&gt;' style="fontFamily=Courier New;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1473" y="382" width="380" height="78" as="geometry"/></mxCell><mxCell id="c156" value="3" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1415" y="482" width="32" height="32" as="geometry"/></mxCell><mxCell id="c157" value="&lt;b&gt;Add workers live&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1461" y="480" width="400" height="26" as="geometry"/></mxCell><mxCell id="c158" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F6FA;strokeColor=#C9D4E3;strokeWidth=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1461" y="512" width="400" height="92" as="geometry"/></mxCell><mxCell id="c159" value="RATE_LIMIT_PER_MIN=0 \&lt;br&gt;docker compose up -d \&lt;br&gt;&amp;nbsp;&amp;nbsp;--scale worker=3" style="fontFamily=Courier New;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1473" y="522" width="380" height="78" as="geometry"/></mxCell><mxCell id="c160" value="4" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1415" y="622" width="32" height="32" as="geometry"/></mxCell><mxCell id="c161" value="&lt;b&gt;Load it again, compare&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1461" y="620" width="400" height="26" as="geometry"/></mxCell><mxCell id="c162" value="" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F6FA;strokeColor=#C9D4E3;strokeWidth=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1461" y="652" width="400" height="92" as="geometry"/></mxCell><mxCell id="c163" value='same bench command&lt;br&gt;&lt;font color="#555555"&gt;about 27 published/s, 0 duplicates&lt;/font&gt;' style="fontFamily=Courier New;text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1473" y="662" width="380" height="78" as="geometry"/></mxCell><mxCell id="c164" value='Watch it: &lt;font face="Courier New"&gt;docker stats&lt;/font&gt; for CPU per replica, and &lt;font face="Courier New"&gt;GET /metrics&lt;/font&gt; for the age of the oldest publication waiting.' style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#555555;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1415" y="780" width="450" height="80" as="geometry"/></mxCell><mxCell id="c165" value="Per worker: concurrency 2 ÷ 0.2 s newswire = 10 publications/s at most, 9 measured. The expected peak is 0.17/s, so even one worker has about 50× margin." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="1820" height="28" as="geometry"/></mxCell><mxCell id="c166" value="Blue outlines are the same containers on Azure (2 workers there measured about 15/s under Azure limits). Compose is the local twin; Azure is validated offline, never applied." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="965" width="1820" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>