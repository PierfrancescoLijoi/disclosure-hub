<mxfile host="app.diagrams.net"><diagram id="d1" name="Local architecture"><mxGraphModel dx="1920" dy="990" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1920" pageHeight="990" math="0" shadow="0" defaultFontFamily="Helvetica"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c6" value="docker compose up (one machine)" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#2F6DB5;strokeWidth=2;fontSize=18;fontColor=#2F6DB5;fontStyle=1;align=left;verticalAlign=top;dashed=1;dashPattern=8 6;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="290" y="170" width="1070" height="710" as="geometry"/></mxCell><mxCell id="c33" value="How one filing flows" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=2;fontSize=20;fontColor=#444444;fontStyle=1;align=left;verticalAlign=top;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1400" y="170" width="480" height="710" as="geometry"/></mxCell><mxCell id="c16" value="sign-in" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#666666;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="HTTPS" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#2F6DB5;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="HTTPS" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#2F6DB5;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="/api" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=3;strokeColor=#2F6DB5;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="JWKS" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#666666;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="reads, writes" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.08609271523178808;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="jobs" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.29304635761589404;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="outbox" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="outbox" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.706953642384106;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="schema" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#C98600;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9139072847682119;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="SMTP" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;strokeColor=#666666;fontSize=14;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="Disclosure Hub on a laptop" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=40;fontColor=#333333;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="1300" height="56" as="geometry"/></mxCell><mxCell id="c3" value="docker compose up. Same image and same code as on Azure: a role and a few variables decide what each container does." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1800" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Staff&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal'&gt;author, approver, publisher&lt;/font&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=3;strokeColor=#1A1A1A;fillColor=#FFFFFF;fontSize=16;fontStyle=1;fontColor=#222222;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="200" width="54" height="96" as="geometry"/></mxCell><mxCell id="c5" value="Readers&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal'&gt;public, no sign-in&lt;/font&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=3;strokeColor=#1A1A1A;fillColor=#FFFFFF;fontSize=16;fontStyle=1;fontColor=#222222;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="520" width="54" height="96" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;keycloak :8081&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;OIDC sign-in, roles in the token&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Microsoft Entra ID&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="330" y="235" width="250" height="104" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;web (nginx) :8080&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;serves the app, caches /api/public&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Front Door Premium and WAF&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="250" height="104" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;mailpit :8025&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;SMTP sink with an inbox page&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Communication Services Email&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="330" y="485" width="250" height="104" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;api &amp;nbsp;ROLE=api :3000&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;REST, public reads, checks the token&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Container App, 2+ replicas&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="680" y="235" width="250" height="104" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;worker &amp;nbsp;ROLE=worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;files to a mock RNS, EDGAR or Nasdaq Copenhagen, retries&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Container App, no ingress&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="250" height="104" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;notifier &amp;nbsp;ROLE=events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;reader e-mails from the outbox&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: one app per consumer set&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="680" y="485" width="250" height="104" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;agents &amp;nbsp;ROLE=events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;AI pre-check with a mock model&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: same, scaled on outbox lag&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="680" y="610" width="250" height="104" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;migrate &amp;nbsp;(runs once)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;schema first, then api and worker start&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Container Apps job&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F3F3;strokeColor=#666666;strokeWidth=2;fontSize=16;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="680" y="735" width="250" height="104" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;postgres 16&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#555555'&gt;data, job queue (LISTEN/NOTIFY),&lt;br&gt;event outbox, audit chain&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#0078D4'&gt;Azure: Flexible Server,&lt;br&gt;zone-redundant HA, Entra-only&lt;/font&gt;" style="fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C98600;strokeWidth=2;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1060" y="235" width="250" height="604" as="geometry"/></mxCell><mxCell id="c27" value="1" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="316" y="221" width="32" height="32" as="geometry"/></mxCell><mxCell id="c28" value="2" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="666" y="221" width="32" height="32" as="geometry"/></mxCell><mxCell id="c29" value="3" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="666" y="346" width="32" height="32" as="geometry"/></mxCell><mxCell id="c30" value="4" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1046" y="221" width="32" height="32" as="geometry"/></mxCell><mxCell id="c31" value="5" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="666" y="471" width="32" height="32" as="geometry"/></mxCell><mxCell id="c32" value="6" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="316" y="471" width="32" height="32" as="geometry"/></mxCell><mxCell id="c34" value="1" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1425" y="234" width="32" height="32" as="geometry"/></mxCell><mxCell id="c35" value="Staff sign in through Keycloak. The token carries the role." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="230" width="390" height="90" as="geometry"/></mxCell><mxCell id="c36" value="2" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1425" y="341" width="32" height="32" as="geometry"/></mxCell><mxCell id="c37" value="The API saves the revision, the approvals and the audit entry in one transaction." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="337" width="390" height="90" as="geometry"/></mxCell><mxCell id="c38" value="3" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1425" y="448" width="32" height="32" as="geometry"/></mxCell><mxCell id="c39" value="The worker claims the job with a lease, files it, and retries if the wire fails." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="444" width="390" height="90" as="geometry"/></mxCell><mxCell id="c40" value="4" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1425" y="555" width="32" height="32" as="geometry"/></mxCell><mxCell id="c41" value="Publishing writes an event to the outbox in the same transaction." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="551" width="390" height="90" as="geometry"/></mxCell><mxCell id="c42" value="5" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1425" y="662" width="32" height="32" as="geometry"/></mxCell><mxCell id="c43" value="Notifier and agents drain the outbox on their own, so a slow mailbox never delays a filing." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="658" width="390" height="90" as="geometry"/></mxCell><mxCell id="c44" value="6" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1425" y="769" width="32" height="32" as="geometry"/></mxCell><mxCell id="c45" value="Readers get an e-mail, the Atom feed or a webhook. The public archive is cached." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="765" width="390" height="90" as="geometry"/></mxCell><mxCell id="c46" value="Blue outlines are the same containers on Azure. The white boxes (Keycloak, nginx, Mailpit) are what managed services replace." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="905" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c47" value="Docker Compose is the local twin; the Azure side is written and validated offline, never applied." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="1800" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
